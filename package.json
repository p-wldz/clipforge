{
  "name": "clipforge",
  "version": "0.15.0",
  "type": "module",
  "description": "Local-first gameplay highlight pipeline with Codex, Claude and DeepSeek adapters",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs",
    ".agents",
    ".claude",
    "tools"
  ],
  "bin": {
    "clipforge": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-dashboard.mjs",
    "start": "node dist/cli.js",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package:check": "npm pack --dry-run",
    "release:archive": "node scripts/create-release-archive.mjs",
    "ci": "npm run typecheck && npm test && npm run build && node --check src/dashboard/app.js && npm run package:check",
    "prepublishOnly": "npm run ci"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "3.5.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
