{
  "name": "clipforge",
  "version": "0.15.1",
  "type": "module",
  "description": "Local-first CLI and dashboard for reviewing gameplay highlights and creating editable video montages",
  "keywords": [
    "video",
    "gameplay",
    "highlights",
    "montage",
    "clips",
    "ffmpeg",
    "local-first",
    "cli"
  ],
  "homepage": "https://github.com/p-wldz/clipforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-wldz/clipforge.git"
  },
  "bugs": {
    "url": "https://github.com/p-wldz/clipforge/issues"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs",
    ".agents",
    ".claude",
    "tools/audio_windowing.py",
    "tools/classify_sound_ast.py",
    "tools/transcribe_faster_whisper.py"
  ],
  "bin": {
    "clipforge": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-dashboard.mjs",
    "start": "node dist/cli.js",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "package:check": "npm pack --dry-run",
    "release:archive": "node scripts/create-release-archive.mjs",
    "release:archive:check": "node scripts/check-release-archive.mjs",
    "release:version:check": "node scripts/check-release-version.mjs",
    "ci": "npm run typecheck && npm run build && npm test && node --check src/dashboard/app.js && npm run package:check",
    "prepublishOnly": "npm run ci"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "3.5.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
